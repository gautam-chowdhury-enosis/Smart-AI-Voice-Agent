# ==============================================================================
# Production TLS termination — SEC-09
#
# The official nginx image renders every file in /etc/nginx/templates through
# envsubst into /etc/nginx/conf.d. Only variables that exist in the container
# environment are substituted, so nginx runtime variables such as $host, $uri
# and $proxy_add_x_forwarded_for pass through untouched.
#
# Required environment (see .env.example):
#   TLS_CONSUMER_HOST  public hostname of the guest portal
#   TLS_ADMIN_HOST     public hostname of the operations console
#   TLS_API_HOST       public hostname of the API gateway (also the signalling
#                      origin baked into the UI bundles as VITE_API_BASE_URL)
#   TLS_CERT_FILE      path to the certificate chain inside the container
#   TLS_KEY_FILE       path to the private key inside the container
# ==============================================================================

# ── Port 80: ACME challenge + permanent redirect to HTTPS ─────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${TLS_CONSUMER_HOST} ${TLS_ADMIN_HOST} ${TLS_API_HOST};

    # Container health probe — answered before the redirect below.
    location = /healthz {
        access_log off;
        add_header Content-Type "text/plain" always;
        return 200 "ok\n";
    }

    # Certificate renewal must stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 308 keeps the method and body across the upgrade to HTTPS.
    location / {
        return 308 https://$host$request_uri;
    }
}

# ── Guest portal ──────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${TLS_CONSUMER_HOST};

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    include /etc/nginx/snippets/tls-params.conf;

    location / {
        include /etc/nginx/snippets/security-headers.conf;

        # The SPA container ships a development CSP aimed at http://localhost.
        # Drop it and issue one that allows the HTTPS API origin instead.
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://${TLS_API_HOST} wss://${TLS_API_HOST} stun:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

        proxy_pass http://consumer_ui:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}

# ── Operations console ────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${TLS_ADMIN_HOST};

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    include /etc/nginx/snippets/tls-params.conf;

    # Knowledge-base uploads are capped at 10 MB by the API.
    client_max_body_size 12m;

    location / {
        include /etc/nginx/snippets/security-headers.conf;

        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://${TLS_API_HOST} wss://${TLS_API_HOST} stun:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

        proxy_pass http://admin_ui:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}

# ── API gateway ───────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${TLS_API_HOST};

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    include /etc/nginx/snippets/tls-params.conf;

    client_max_body_size 12m;

    # Locations below add no headers of their own, so they inherit these.
    include /etc/nginx/snippets/security-headers.conf;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Pinned to the backend's proxy_trust address: `backend` also resolves on the
    # shared default network, where the gateway would not trust our X-Forwarded-For.
    location /api/ {
        proxy_pass http://${BACKEND_PROXY_TRUST_IP}:8000;
    }

    location = /health {
        proxy_pass http://${BACKEND_PROXY_TRUST_IP}:8000;
    }

    location = /openapi.json {
        proxy_pass http://${BACKEND_PROXY_TRUST_IP}:8000;
    }

    location = /docs {
        proxy_pass http://${BACKEND_PROXY_TRUST_IP}:8000;
    }

    location = /redoc {
        proxy_pass http://${BACKEND_PROXY_TRUST_IP}:8000;
    }

    location / {
        return 404;
    }
}
