# ==============================================================================
# Smart AI Voice Agent — Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# Default setting is 100% LOCAL-FIRST ($0 Compute).
# ==============================================================================

# --- AI PROVIDER SELECTION ---
# Options: ollama (local, default) | gemini | groq | openai
LLM_PROVIDER=ollama
# Options: faster_whisper (local, default) | deepgram | groq
STT_PROVIDER=faster_whisper
# Options: kokoro (local, default) | piper | cartesia | elevenlabs
TTS_PROVIDER=kokoro

# --- LOCAL OLLAMA CONFIGURATION (No API Key Required) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- LOCAL STT & TTS SETTINGS ---
FASTER_WHISPER_MODEL=base.en
KOKORO_VOICE_ID=af_sarah
KOKORO_SPEED=1.00

# --- CLOUD AI PROVIDERS (Only required if switching from local) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49

# --- GATEWAY & SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development
# Required for admin API access. Generate a unique random value; no default is provided.
ADMIN_API_KEY=

# --- BROWSER CORS ORIGINS ---
# Comma-separated exact browser origins allowed to call the gateway.
# Use the scheme/host the browser actually loads (no trailing slash). Add the
# HTTPS origins here when running behind the TLS proxy.
ADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONSUMER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- REVERSE PROXY TRUST (SEC-09) ---
# Comma-separated IPs/CIDRs whose X-Forwarded-For header may be believed for
# per-IP rate limiting. Leave empty unless the gateway runs behind a proxy.
# docker-compose.prod.yml defaults this to the Compose bridge range.
TRUSTED_PROXY_IPS=

# --- PRODUCTION TLS TERMINATION (SEC-09) ---
# Public hostnames served by the nginx TLS proxy; each must resolve to this host.
# Only used by docker-compose.prod.yml. VITE_API_BASE_URL is derived from
# TLS_API_HOST at build time, so the UIs must be rebuilt when it changes.
TLS_CONSUMER_HOST=voice.example.com
TLS_ADMIN_HOST=admin.voice.example.com
TLS_API_HOST=api.voice.example.com
# Certificate chain and key paths inside the proxy container (mounted from ./certs).
TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem
TLS_KEY_FILE=/etc/nginx/certs/privkey.pem

# --- PERSISTENCE & DATA STORAGE ---
DATABASE_URL=sqlite:///./data/voice_agent.db
CHROMA_PERSIST_DIR=./data/chroma_db
# Optional database encryption key for SQLCipher storage at rest (SEC-10).
# In production, either configure DB_ENCRYPTION_KEY or use volume-level encryption (LUKS / encrypted EBS).
DB_ENCRYPTION_KEY=
LOG_LEVEL=INFO

# --- RAG EMBEDDINGS (local-first; no model download by default) ---
# Options: local_hash (default) | nomic_ollama | fastembed
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=nomic-embed-text

# --- WEATHER (local stub by default; Open-Meteo needs no API key) ---
# Options: stub | open_meteo
WEATHER_PROVIDER=stub
